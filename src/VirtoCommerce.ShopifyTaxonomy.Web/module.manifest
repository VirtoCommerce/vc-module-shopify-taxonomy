<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.ShopifyTaxonomy</id>
  <version>3.1001.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1039.12</platformVersion>
  <dependencies>
      <dependency id="VirtoCommerce.Catalog" version="3.1029.6" />
  </dependencies>

  <title>Shopify Taxonomy Importer</title>
  <description>Importing Shopify's Standard Product Taxonomy into Virto Commerce catalog</description>

  <authors>
    <author>Konstantin Savosteev</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-shopify-taxonomy</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.ShopifyTaxonomy)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.ShopifyTaxonomy.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.ShopifyTaxonomy.Web.Module, VirtoCommerce.ShopifyTaxonomy.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 VirtoCommerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
